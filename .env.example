# Gemini TTS — синтез голоса
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Если пусто, голос выбирается случайно из x-voices.md и сохраняется в сценарий.
GEMINI_TTS_VOICE=

# z.ai API (GLM Coding Pro) — генерация сценариев
ZAI_API_KEY=your_zai_api_key_here
ZAI_API_URL=https://api.z.ai/api/coding/paas/v4

# LLM backend: codex-cli (по умолчанию), claude-cli или zai-api
LLM_BACKEND=codex-cli
# Модель для Codex, Claude и z.ai
LLM_MODEL=
# Effort/thinking level: claude-cli -> --effort, codex-cli -> model_reasoning_effort, zai-api -> low disables thinking
LLM_EFFORT=

# Puppeteer сервис, запущенный локально на хост-машине
PUPPETEER_URL=http://localhost:3333

# Пути
RAW_DIR=./raw
OUTPUT_DIR=./output
STATE_DIR=./state

# Язык: ru (по умолчанию), en-us, en-au, zh-cn, hi, ja, es-mx, fr, pt-br, id
# VIDEO_LANG=ru

# Настройки видео
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# YouTube автопубликация
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Настройки публикации задаются на язык запуска VIDEO_LANG.

TERMINAL_TITLE_RU=
YOUTUBE_PLAYLIST_ID_RU=
YOUTUBE_SCHEDULE_LOCATION_RU=Europe/Moscow
YOUTUBE_SCHEDULE_TIME_RU=10:00

TERMINAL_TITLE_EN_US=
YOUTUBE_PLAYLIST_ID_EN_US=
YOUTUBE_SCHEDULE_LOCATION_EN_US=America/New_York
YOUTUBE_SCHEDULE_TIME_EN_US=10:00

