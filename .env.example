# z.ai API (GLM Coding Pro) — генерация сценариев
ZAI_API_KEY=your_zai_api_key_here
ZAI_API_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5

# SaluteSpeech (Сбер) — синтез русского голоса
# Получить в: https://developers.sber.ru/portal/products/salutespeech
SALUTESPEECH_CLIENT_ID=your_client_id_here
SALUTESPEECH_CLIENT_SECRET=your_client_secret_here
# SALUTE_SPEECH_PERS — физ. лицо, SALUTE_SPEECH_CORP — юр. лицо
SALUTESPEECH_SCOPE=SALUTE_SPEECH_PERS
# Женский голос: Nec_24000 (нейтральный), Bys_24000 (деловой)
SALUTESPEECH_VOICE=Nec_24000

# Puppeteer сервис
PUPPETEER_URL=http://localhost:3333

# Режим запуска: true = через docker-compose, false = локально (по умолчанию)
VIA_DOCKER=false

# LLM бэкенд: zai (по умолчанию) или claude-cli (локально через Claude Code CLI)
LLM_BACKEND=claude-cli

# Пути
RAW_DIR=./raw
OUTPUT_DIR=./output
STATE_DIR=./state

# Настройки видео
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
