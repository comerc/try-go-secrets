# Gemini TTS — синтез голоса
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Если пусто, голос выбирается случайно из x-voices.md и сохраняется в сценарий.
GEMINI_TTS_VOICE=

# z.ai API (GLM Coding Pro) — генерация сценариев
ZAI_API_KEY=your_zai_api_key_here
ZAI_API_URL=https://api.z.ai/api/coding/paas/v4

# LLM backend: codex-cli (по умолчанию), claude-cli или zai-api
LLM_BACKEND=codex-cli
# Модель для Codex, Claude и z.ai
LLM_MODEL=
# Effort/thinking level: claude-cli -> --effort, codex-cli -> model_reasoning_effort, zai-api -> low disables thinking
LLM_EFFORT=

# Puppeteer сервис, запущенный локально на хост-машине
PUPPETEER_URL=http://localhost:3333

# Пути
RAW_DIR=./raw
OUTPUT_DIR=./output
STATE_DIR=./state

# Настройки видео
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
PLAYLIST_TITLE="300 Golang-secrets"
LANG=ru

# YouTube автопубликация
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PLAYLIST_ID=
# Публиковать один ролик в день в этой таймзоне и времени.
YOUTUBE_SCHEDULE_LOCATION=Europe/Moscow
YOUTUBE_SCHEDULE_TIME=12:00
